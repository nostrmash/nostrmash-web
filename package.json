{
  "name": "nostrmash-web",
  "version": "0.1.0",
  "private": true,
  "description": "Public explorer for NostrMash. Search notes and profiles, and browse trends, relays, and network stats.",
  "author": "NostrMash",
  "license": "Unlicense",
  "homepage": "https://nostrmash.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nostrmash/nostrmash-web.git"
  },
  "bugs": {
    "url": "https://github.com/nostrmash/nostrmash-web/issues"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint --cache --cache-location ./.next/cache/eslint .",
    "lint:fix": "eslint --cache --cache-location ./.next/cache/eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "precheck": "pnpm lint && pnpm typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy": "wrangler deploy --keep-vars",
    "cf:typegen": "wrangler types",
    "prod:validate": "node scripts/prod-validate.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "generate:api-types": "openapi-typescript ../nostrmash/docs/openapi.yaml -o lib/types/generated/api.d.ts"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@sentry/nextjs": "^11.14.0",
    "hls.js": "^1.7.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --cache-location ./.next/cache/eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@apm-js-collab/code-transformer": "link:./stubs/packages/code-transformer",
      "@apm-js-collab/code-transformer-bundler-plugins": "link:./stubs/packages/code-transformer-bundler-plugins",
      "@apm-js-collab/tracing-hooks": "link:./stubs/packages/tracing-hooks",
      "vite": "8.3.8",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@<1.1.22": "1.1.22",
      "brace-expansion@>=2.0.0 <2.1.8": "2.1.8",
      "@humanfs/node@<0.16.8": "0.16.8",
      "glob@>=10.2.0 <10.5.0": "10.5.0"
    }
  }
}
